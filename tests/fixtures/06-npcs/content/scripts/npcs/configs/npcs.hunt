[npcs_hunt_prey]
type=npc
check_npc=npcs_prey
check_vis=lineofsight
nobodynear=keephunting
find_newmode=opnpc1
find_keephunting=off

[npcs_hunt_follow]
type=npc
check_category=npcs_prey_cat
check_vis=lineofwalk
nobodynear=keephunting
find_newmode=apnpc1
rate=3

[npcs_hunt_obj]
type=obj
check_obj=fixture_boots
nobodynear=keephunting
find_newmode=opobj1

[npcs_hunt_loc]
type=scenery
check_loc=fixture_fountain
nobodynear=keephunting
find_newmode=queue3
find_keephunting=on
rate=4
